{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VupsRouter",
  "version": "2.1.1",
  "identifier": "com.vupsrouter.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENjY5NjA0M0EwOTU0NTEKUldSUlZBazZCSlptWGMxQ1pMNjQ4SHdhbXNuNGVSUktDckRmMy81bDB4bVBNTy9FVUZoMDdUUnIK",
      "endpoints": [
        "https://github.com/CrazyVillainFF/Vups-Router/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "VupsRouter desktop workspace",
    "longDescription": "A dedicated Windows window for the live VupsRouter AI workspace."
  }
}
