{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the VupsRouter desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-workspace-commands",
    "allow-desktop-tools",
    "allow-composer-files",
    "allow-panel-browser",
    "allow-panel-terminal",
    "allow-skills-commands",
    "updater:default",
    "process:allow-restart"
  ]
}
