{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-local",
  "description": "Allow the bundled VupsRouter desktop workspace and its loopback API origin to use local workspace commands.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-workspace-commands",
    "allow-desktop-tools",
    "allow-composer-files",
    "allow-panel-browser",
    "allow-panel-terminal",
    "allow-skills-commands",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" }
      ]
    }
  ]
}
