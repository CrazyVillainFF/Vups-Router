{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VupsRouter",
  "version": "1.0.0",
  "identifier": "com.vupsrouter.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VupsRouter",
        "url": "https://vups-router-three.vercel.app/",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "VupsRouter desktop workspace",
    "longDescription": "A dedicated Windows window for the live VupsRouter AI workspace."
  }
}
