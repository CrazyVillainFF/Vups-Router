{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VupsRouter QA",
  "version": "1.0.0",
  "identifier": "com.vupsrouter.desktop.qa",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VupsRouter QA",
        "url": "http://127.0.0.1:4180/chat?native=windows",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
