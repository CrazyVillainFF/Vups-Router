    "guard:contrast": "node qa/guard-render.mjs --only=contrast",
    "guards": "npm run guard:reach && npm run guard:style && npm run guard:hex && npm run guard:selftest && node qa/guard-render.mjs --only=paint,blue,clip,contrast",
