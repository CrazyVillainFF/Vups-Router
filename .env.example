# VupsRouter client environment variables

# Local dev/preview proxies /api to this backend (server-side only).
# Defaults to https://vups-router-be.onrender.com.
# VITE_API_PROXY_TARGET=http://localhost:4000

# Call a backend directly from the browser instead of using the /api proxy.
# Uncomment only when using a different local backend.
# VITE_API_BASE_URL=http://localhost:4000/api

# Production always uses the same-origin proxy declared in vercel.json
# (/api/* -> https://vups-router-be.onrender.com/api/*). Relative values such as
# /api are honored; absolute backend URLs are ignored in production because they
# make the HttpOnly vr_session cookie third-party, which browsers can block on
# refresh. The production build fails if this value points at localhost.

# NOTE: Do NOT put AI provider API keys here. Users enter their own key in
# API Settings; it is encrypted and stored server-side only.

# --- Image attachments (optional; must stay <= the server's limits) --------
# The composer lets users attach PNG/JPEG/WebP/GIF images (picker, drag & drop,
# or paste) to the current message. Defaults mirror the server defaults.
# VITE_IMAGE_MAX_COUNT=4
# VITE_IMAGE_MAX_BYTES=4194304
# VITE_IMAGE_MAX_TOTAL_BYTES=8388608

# --- Legal / operator configuration ---------------------------------------
# The legal pages (/privacy-policy, /terms, /cookie-policy) are generated from
# these values. The defaults are clearly marked placeholders - set the real
# details here (or in Vercel env vars) before relying on the pages publicly.
# VITE_LEGAL_OPERATOR_NAME=VupsRouter
# VITE_LEGAL_ENTITY=Example Labs Ltd.
# VITE_LEGAL_JURISDICTION=England and Wales
# VITE_LEGAL_CONTACT_EMAIL=legal@example.com
# VITE_LEGAL_EFFECTIVE_DATE=2026-10-19
# VITE_LEGAL_MINIMUM_AGE=16
# VITE_LEGAL_RETENTION_DESCRIPTION=Account data is deleted within 30 days of an account-deletion request.
# VITE_LEGAL_SITE_URL=https://vups-router-three.vercel.app

# NOTE: if you change VITE_API_BASE_URL to a different backend origin, also add
# that origin to connect-src in vercel.json (Content-Security-Policy) or the
# browser will block API requests in production.
