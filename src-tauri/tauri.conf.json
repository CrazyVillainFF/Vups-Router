{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VupsRouter",
  "version": "1.0.3",
  "identifier": "com.vupsrouter.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "VupsRouter desktop workspace",
    "longDescription": "A dedicated Windows window for the live VupsRouter AI workspace."
  }
}
